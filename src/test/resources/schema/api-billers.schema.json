{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "title": "Billers (GRAD-301 GET /billers cavabı)",
  "type": "object",
  "required": [
    "items",
    "total"
  ],
  "properties": {
    "total": {
      "type": "integer",
      "minimum": 0
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "category",
          "subscriberFormat",
          "subscriberPattern",
          "minAmount",
          "maxAmount",
          "fee"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "category": {
            "type": "string",
            "enum": [
              "MOBILE",
              "UTILITY",
              "INTERNET"
            ]
          },
          "subscriberFormat": {
            "type": "string"
          },
          "subscriberPattern": {
            "type": "string"
          },
          "minAmount": {
            "type": "number"
          },
          "maxAmount": {
            "type": "number"
          }
        }
      }
    }
  }
}