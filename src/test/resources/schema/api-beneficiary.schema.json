{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "title": "Beneficiary (GRAD-101 POST /beneficiaries cavabı)",
  "type": "object",
  "required": [
    "id",
    "fullName",
    "iban",
    "ibanMasked",
    "currency",
    "createdAt"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^ben_[a-z0-9]{8}$"
    },
    "fullName": {
      "type": "string",
      "minLength": 2,
      "maxLength": 50
    },
    "iban": {
      "type": "string",
      "pattern": "^AZ[0-9]{2}[A-Z0-9]{24}$"
    },
    "ibanMasked": {
      "type": "string"
    },
    "currency": {
      "type": "string",
      "enum": [
        "AZN",
        "USD",
        "EUR"
      ]
    },
    "nickname": {
      "type": [
        "string",
        "null"
      ]
    },
    "createdAt": {
      "type": "string",
      "minLength": 1
    }
  }
}